{
  "name": "kaal-app",
  "version": "1.0.0",
  "description": "Kaal - Elegant Focus, Task Management, & AI Productivity Companion",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win"
  },
  "keywords": [
    "productivity",
    "pomodoro",
    "music",
    "tasks",
    "ai"
  ],
  "author": "Kaal Developer",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.kaal.app",
    "productName": "Kaal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kaal"
    }
  }
}
